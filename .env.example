# ═══════════════════════════════════════════════════════════
# SantéConnect — Variables d'environnement
# Copier ce fichier : cp .env.example .env
# IMPORTANT : Ne jamais committer le fichier .env !
# ═══════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────
NODE_ENV=development
APP_NAME=SantéConnect
APP_PORT=3001
APP_URL=http://localhost:3001

# ─── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_APP_NAME=SantéConnect

# ─── Base de données PostgreSQL ────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=santeconnect
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=santeconnect_db
DATABASE_URL=postgresql://santeconnect:change_me_in_production@postgres:5432/santeconnect_db

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_in_production
REDIS_URL=redis://:change_me_redis_in_production@redis:6379

# ─── JWT Authentication ────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── Chiffrement (AES-256) ─────────────────────────────────
ENCRYPTION_KEY=your_32_char_encryption_key_here_!!

# ─── Email (SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@santeconnect.fr

# ─── Firebase (Push Notifications) ────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ─── Stockage fichiers (S3 / OVHcloud) ────────────────────
S3_ENDPOINT=https://s3.gra.cloud.ovh.net
S3_REGION=gra
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=santeconnect-uploads

# ─── Keycloak (OAuth2 / OIDC) ─────────────────────────────
KEYCLOAK_URL=http://localhost:8082
KEYCLOAK_REALM=santeconnect
KEYCLOAK_CLIENT_ID=santeconnect-api
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret

# ─── Logs ──────────────────────────────────────────────────
LOG_LEVEL=debug
